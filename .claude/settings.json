{
  "permissions": {
    "allow": ["Bash(rtk ls *)", "Bash(rtk find *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/git-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git policy..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/propose-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking worktree policy..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/worktree-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking worktree policy..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/propose-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking worktree policy..."
          }
        ]
      }
    ]
  }
}
